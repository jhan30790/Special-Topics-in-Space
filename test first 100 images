def crater_level_eval(gt_df, idx, pred_circles):
    possible_names = [
        f"tile_{idx:04d}.png",
        f"dev_image_{idx:05d}.png",
        f"img_{idx:05d}.png"
    ]

    gt_sub = gt_df[gt_df["FileName"].isin(possible_names)].copy()

    if GT_DIAMETER_MIN > 0:
        gt_sub = gt_sub[gt_sub["Diameter (pix)"] >= GT_DIAMETER_MIN]

    gt_circles = []

    for _, row in gt_sub.iterrows():
        gt_circles.append({
            "x_center": float(row["x"]),
            "y_center": float(row["y"]),
            "radius": float(row["Diameter (pix)"]) / 2
        })

    pred_circles = pred_circles if pred_circles is not None else []

    gt_matched = [False] * len(gt_circles)
    pred_matched = [False] * len(pred_circles)

    CENTER_TOL = 25
    RADIUS_TOL_RATIO = 0.5

    for pi, pred_c in enumerate(pred_circles):
        px = pred_c["x_center"]
        py = pred_c["y_center"]
        pr = pred_c["radius"]

        best_gi = None
        best_dist = 1e9

        for gi, gt_c in enumerate(gt_circles):
            if gt_matched[gi]:
                continue

            gx = gt_c["x_center"]
            gy = gt_c["y_center"]
            gr = gt_c["radius"]

            dist = np.sqrt((px - gx) ** 2 + (py - gy) ** 2)
            radius_diff = abs(pr - gr)
            radius_tol = max(8, gr * RADIUS_TOL_RATIO)

            if dist < CENTER_TOL and radius_diff < radius_tol:
                if dist < best_dist:
                    best_dist = dist
                    best_gi = gi

        if best_gi is not None:
            pred_matched[pi] = True
            gt_matched[best_gi] = True

    TP = sum(pred_matched)
    FP = len(pred_circles) - TP
    FN = len(gt_circles) - sum(gt_matched)

    accuracy = TP / (TP + FP + FN + 1e-8)
    precision = TP / (TP + FP + 1e-8)
    recall = TP / (TP + FN + 1e-8)
    f1 = 2 * precision * recall / (precision + recall + 1e-8)

    return {
        "GT_craters": len(gt_circles),
        "Pred_craters": len(pred_circles),
        "TP": TP,
        "FP": FP,
        "FN": FN,
        "Accuracy": accuracy,
        "Precision": precision,
        "Recall": recall,
        "F1_score": f1
    }


